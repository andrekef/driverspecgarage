    const LS_KEY = 'dsg_customers_v1';

    // ── Storage helpers ────────────────────────────────────────────────────
    function loadCustomContacts() {
        try {
            return JSON.parse(localStorage.getItem(LS_KEY)) || [];
        } catch { return []; }
    }

    function saveCustomContacts(list) {
        localStorage.setItem(LS_KEY, JSON.stringify(list));
    }

    function getAllContacts() {
        const custom = loadCustomContacts();
        // Custom contacts appear first so they're easy to find
        return [...custom, ...DEFAULT_CONTACTS];
    }

    function addContact(contact) {
        const custom = loadCustomContacts();
        custom.unshift(contact); // newest first
        saveCustomContacts(custom);
        return getAllContacts();
    }

    // ── Normalize phone for Calendly (+1XXXXXXXXXX) ────────────────────────
    function normalizePhone(raw) {
        if (!raw) return '+1';
        const digits = raw.replace(/\D/g, '');
        if (digits.length === 10) return '+1' + digits;
        if (digits.length === 11 && digits.startsWith('1')) return '+' + digits;
        return '+1' + digits;
    }

